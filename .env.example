# ---------------------------------------------------------------------------
# Telegram API credentials
# ---------------------------------------------------------------------------
# Bot token from @BotFather (BotFather -> /newbot or /token).
BOT_TOKEN=123456789:replace-with-your-bot-token

# API ID and API hash from https://my.telegram.org -> API development tools.
# These are NOT the bot token.
API_ID=123456
API_HASH=replace-with-your-api-hash

# Bot username WITHOUT the leading @, e.g. my_file_sharing_bot.
# Used to build t.me deep links, so it must match the real bot username.
BOT_USERNAME=my_file_sharing_bot

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Comma-separated numeric Telegram user IDs allowed to upload files and run
# admin commands. Get your ID from @userinfobot.
ADMIN_IDS=123456789,987654321

# ---------------------------------------------------------------------------
# Turso database (required)
# ---------------------------------------------------------------------------
# From: turso db show <database-name> --url
# The URL normally starts with libsql://. The bot converts it to the Turso
# HTTPS HTTP API automatically; an https:// URL is also accepted.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io

# From: turso db tokens create <database-name> --expiration never
# Store this as a Render secret, never commit it.
TURSO_AUTH_TOKEN=replace-with-your-turso-auth-token

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Channel where files are copied (no "forwarded from" tag). The bot must be an
# administrator with permission to post messages.
# Numeric private channel IDs start with -100, e.g. -1001234567890.
# A public @username is also accepted.
STORAGE_CHANNEL=-1001234567890

# ---------------------------------------------------------------------------
# Library posts (/newpost, /editpost)
# ---------------------------------------------------------------------------
# LINKS_CHANNEL receives the post with the per-quality download buttons. It can
# be public (@username) or private (-100...); the bot must be an administrator
# with permission to post messages.
LINKS_CHANNEL=

# LIBRARY_CHANNEL is the public-facing channel that links to the LINKS_CHANNEL
# post. The bot must be an administrator with permission to post messages.
LIBRARY_CHANNEL=

# ---------------------------------------------------------------------------
# Link shortener (VPLink)
# ---------------------------------------------------------------------------
# API key from https://vplink.in. Shortening is best-effort: if the service is
# down the bot still sends the direct Telegram link.
VPLINK_API_KEY=replace-with-your-vplink-api-key

# ---------------------------------------------------------------------------
# Optional force-subscribe gate
# ---------------------------------------------------------------------------
# Leave blank to disable. Use @channelusername for a public channel or the
# numeric -100... ID for a private one. The bot must be an administrator.
FORCE_SUB_CHANNEL=

# Recommended for private force-sub channels. If blank, the bot tries to export
# an invite link itself (requires admin rights).
FORCE_SUB_INVITE_LINK=

# ---------------------------------------------------------------------------
# Auto-delete
# ---------------------------------------------------------------------------
# Seconds before the delivered file and its warning message are deleted.
# 600 = 10 minutes. Pending deletions survive restarts via Turso.
AUTO_DELETE_SECONDS=600

# ---------------------------------------------------------------------------
# Advanced (defaults are fine)
# ---------------------------------------------------------------------------
# Port for the built-in keep-alive HTTP server. Render injects PORT
# automatically; 8080 is used for local runs when PORT is unset.
PORT=8080

# Directory for the Pyrogram session. On Render this is ephemeral and does not
# contain the database (Turso stores all bot data).
DATA_DIR=data

# Pyrogram session file name (stored inside DATA_DIR).
SESSION_NAME=telebot

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
